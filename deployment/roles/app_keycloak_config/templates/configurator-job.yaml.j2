---
{% from '_admin_api_job.j2' import account, job with context %}
{{ account('keycloak-configurator', 'configurator.sh', 'keycloak_configurator_job.sh') }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: keycloak-configurator
  namespace: {{ keycloak_namespace }}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "create", "update", "patch"]
{% if (chattool_keycloak_oidc_endpoint is defined and chattool_keycloak_oidc_endpoint) or
      (chattool_keycloak_federation_endpoint is defined and chattool_keycloak_federation_endpoint) %}
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-configurator-sensitive
  namespace: {{ keycloak_namespace }}
  labels:
    app.kubernetes.io/name: keycloak-configurator
    app.kubernetes.io/component: configuration
type: Opaque
data:
{% if chattool_keycloak_oidc_endpoint is defined and chattool_keycloak_oidc_endpoint %}
  oidc-client-secret: {{ chattool_keycloak_oidc_client_secret | default('') | b64encode }}
{% endif %}
{% if chattool_keycloak_federation_endpoint is defined and chattool_keycloak_federation_endpoint %}
  federation-bind-password: {{ chattool_keycloak_federation_bind_password | default('') | b64encode }}
{% endif %}
{% endif %}
---
{% call job('keycloak-configurator', configurator_job_name, 'configurator', 'configurator.sh', 3, 'OnFailure') %}
            - name: MINIO_DOMAIN
              value: "{{ minio_domain }}"
            - name: UI_DOMAIN
              value: "{{ ui_domain }}"
{% if minio_path_prefix is defined %}
            - name: MINIO_PATH_PREFIX
              value: "{{ minio_path_prefix }}"
{% endif %}
            - name: MCP_ENABLED
              value: "{{ mcp_enabled | default(false) | bool | lower }}"
{% if mcp_enabled | default(false) | bool %}
            - name: MCP_CLIENT_ID
              value: "{{ mcp_keycloak_client_id }}"
            - name: MCP_AUDIENCE
              value: "{{ mcp_jwt_audience }}"
            - name: MCP_ACCESS_TOKEN_LIFESPAN
              value: "{{ mcp_access_token_lifespan }}"
{% endif %}
            - name: CREDENTIALS_SECRET_NAME
              value: "{{ credentials_secret_name }}"
            - name: CREDENTIALS_SECRET_NAMESPACE
              value: "{{ keycloak_namespace }}"
{% if chattool_keycloak_oidc_endpoint is defined and chattool_keycloak_oidc_endpoint %}
            - name: OIDC_ENDPOINT
              value: "{{ chattool_keycloak_oidc_endpoint }}"
            - name: OIDC_ALIAS
              value: "{{ chattool_keycloak_oidc_alias | default('enterprise-sso') }}"
            - name: OIDC_CLIENT_ID
              value: "{{ chattool_keycloak_oidc_client_id | default('') }}"
            - name: OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: keycloak-configurator-sensitive
                  key: oidc-client-secret
            - name: OIDC_ADMIN_GID
              value: "{{ chattool_keycloak_oidc_admin_gid | default('') }}"
            - name: OIDC_MAINTAINER_GID
              value: "{{ chattool_keycloak_oidc_maintainer_gid | default('') }}"
            - name: OIDC_USER_GID
              value: "{{ chattool_keycloak_oidc_user_gid | default('') }}"
{% endif %}
{% if chattool_keycloak_federation_endpoint is defined and chattool_keycloak_federation_endpoint %}
            - name: FEDERATION_ENDPOINT
              value: "{{ chattool_keycloak_federation_endpoint }}"
            - name: FEDERATION_BIND_DN
              value: "{{ chattool_keycloak_federation_bind_dn | default('') }}"
            - name: FEDERATION_BIND_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-configurator-sensitive
                  key: federation-bind-password
            - name: FEDERATION_USERS_DN
              value: "{{ chattool_keycloak_federation_users_dn | default('') }}"
            - name: FEDERATION_USER_ATTRIBUTE
              value: "{{ chattool_keycloak_federation_user_attribute | default('sAMAccountName') }}"
            - name: FEDERATION_GROUPS_DN
              value: "{{ chattool_keycloak_federation_groups_dn | default('') }}"
            - name: FEDERATION_USER_GROUP_LDAP_FILTER
              value: "{{ chattool_keycloak_federation_user_group_ldap_filter | default('(cn=chattool-user-group)') }}"
            - name: FEDERATION_MAINTAINER_GROUP_LDAP_FILTER
              value: "{{ chattool_keycloak_federation_maintainer_group_ldap_filter | default('(cn=chattool-maintainer-group)') }}"
            - name: FEDERATION_ADMIN_GROUP_LDAP_FILTER
              value: "{{ chattool_keycloak_federation_admin_group_ldap_filter | default('(cn=chattool-admin-group)') }}"
{% endif %}
{% endcall %}
